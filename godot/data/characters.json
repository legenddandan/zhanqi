{
  "version": 5,
  "description": "第一版通用人物/单位模板。人物通过 classId 继承兵种基础属性和成长规则；statModifiers 用于配置个人差异。",
  "statPolicy": {
    "reservedFields": [
      "level",
      "exp",
      "maxHp",
      "maxMp",
      "attack",
      "defense",
      "magicAttack",
      "magicDefense",
      "hit",
      "evasion",
      "move",
      "minRange",
      "maxRange"
    ],
    "growthRule": "属性以1级基础值为起点；达到 firstAtLevel 后，每 everyLevels 级增加 amount。",
    "damageRule": {
      "physical": "攻击者物理攻击 - 防御者物理防御",
      "magic": "攻击者魔法攻击 - 防御者魔法防御"
    },
    "sourcePolicy": {
      "classTemplate": "兵种提供公共1级基础属性与逐属性成长",
      "characterModifier": "人物可通过 statModifiers.base 和 statModifiers.growth 叠加个人差异，未配置时按0处理",
      "calculation": "当前属性 = 兵种基础 + 兵种成长 + 人物基础修正 + 人物成长修正"
    }
  },
